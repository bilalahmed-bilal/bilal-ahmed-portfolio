# Production canonical site URL (required before deployment)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Real profile links (leave blank until supplied)
NEXT_PUBLIC_UPWORK_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Set false on staging/preview deployments
NEXT_PUBLIC_INDEXABLE=true
# Production contact recipient; email provider integration required before enabling delivery
CONTACT_TO_EMAIL=
